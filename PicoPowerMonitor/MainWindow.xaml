<?xml version="1.0" encoding="utf-8"?>
<!-- v16.0, 6/15/2026 Locking down Max Current to its own Grid.Column. It was bouncing left and right. -->
<Window
    x:Class="PicoPowerMonitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:scottplot="using:ScottPlot.WinUI"
    Title="Pico Power Monitor">


    <Grid
        Background="#11111115"
        Padding="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="150" />
            <RowDefinition Height="150" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="#78111115" 
                BorderBrush="#4A90E2" 
                BorderThickness="1.5" 
                CornerRadius="12" 
                Padding="16"
                Margin="0,0,0,16">
            <Grid>
                <TextBlock Text="VOLTAGE"
                           FontSize="15"
                           FontFamily="Cascadia Code"
                           Foreground="#4A90E2" 
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="VoltageText"
                               Text="0.000"
                               FontSize="64"
                               FontFamily="Cascadia Code"
                               FontWeight="Normal"
                               Margin="0,12,0,0"
                               Foreground="White"/>
                    <TextBlock Text="V"
                               FontSize="64"
                               FontFamily="Cascadia Code"
                               FontWeight="Normal"
                               Foreground="#4A90E2"
                               Margin="16,12,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" 
                Background="#78111115" 
                BorderBrush="#E06C75" 
                BorderThickness="1.5" 
                CornerRadius="12" 
                Padding="16"
                Margin="0,0,0,16">
            <Grid>
                <TextBlock Text="CURRENT" 
                           FontSize="15"
                           FontFamily="Cascadia Code"
                           Foreground="#E06C75" 
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                <Grid VerticalAlignment="Center" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock x:Name="CurrentText" 
                                   Text="0.000"
                                   FontSize="64"
                                   FontFamily="Cascadia Code"
                                   FontWeight="Normal"
                                   Foreground="White"/>
                        <TextBlock Text="A" 
                                   FontSize="64"
                                   FontFamily="Cascadia Code"
                                   FontWeight="Normal"
                                   Foreground="#E06C75" 
                                   Margin="16,0,0,0" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" 
                                Orientation="Vertical" 
                                HorizontalAlignment="Right" 
                                Margin="0,0,16,0" 
                                VerticalAlignment="Center">

                        <TextBlock Text="MAX PEAK"
                                   FontSize="12"
                                   FontFamily="Cascadia Code"
                                   FontWeight="Bold"
                                   Foreground="#8A93A7"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="MaxCurrentText"
                                   Text="0.000"
                                   FontSize="36"
                                   FontFamily="Cascadia Code"
                                   FontWeight="Normal"
                                   Foreground="#E5C07B"
                                   HorizontalAlignment="Center"/>

                        <Button Content="Reset"
                                FontSize="14"
                                FontFamily="Cascadia Code"
                                Margin="0,8,0,0"
                                Padding="8,2"
                                CornerRadius="12"
                                HorizontalAlignment="Center"
                                Click="ResetMaxCurrent_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" 
                Background="#78111115" 
                BorderBrush="#3E4451" 
                BorderThickness="1.5" 
                CornerRadius="12" 
                Padding="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="5,0,0,5">
                    <TextBlock Text="Current"
                               FontSize="15"
                               Foreground="White"
                               FontWeight="Normal"/>
                    <TextBlock Text=" A"
                               FontSize="15"
                               Foreground="#E06C75"
                               FontWeight="Normal"/>
                </StackPanel>

                <scottplot:WinUIPlot x:Name="CurrentSignaturePlot" 
							Grid.Row="1" 
							Margin="0,5"
							HorizontalAlignment="Stretch" 
							VerticalAlignment="Stretch"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5,5,0,0" VerticalAlignment="Center">
                    <Ellipse Name="StatusEllipse"
                             Width="10" 
                             Height="10" 
                             VerticalAlignment="Center" 
                             Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" 
                               FontSize="14" 
                               FontWeight="Medium"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>