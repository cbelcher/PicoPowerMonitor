<?xml version="1.0" encoding="utf-8"?>
<!-- v8.0 6/11/2026 Major UI Changes. -->
<Window
    x:Class="PicoPowerMonitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:scottplot="using:ScottPlot.WinUI"
    Title="Pico Power Monitor">

    <Grid Background="#1E1E24" Padding="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    Background="#111115" 
                    BorderBrush="#4A90E2" 
                    BorderThickness="1.5" 
                    CornerRadius="12" 
                    Padding="15,10">
                <StackPanel>
                    <TextBlock Text="VOLTAGE" 
                               FontSize="12" 
                               FontWeight="Bold" 
                               Foreground="#4A90E2" 
                               Margin="5,0,0,2"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="VoltageText" 
                                   Text="0.000" 
                                   FontSize="44" 
                                   FontWeight="SemiBold"
                                   FontFamily="Consolas" 
                                   Foreground="White"/>
                        <TextBlock Text="V" 
                                   FontSize="32" 
                                   FontWeight="Bold"
                                   Foreground="#4A90E2" 
                                   Margin="12,0,0,0" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" 
                    Background="#111115" 
                    BorderBrush="#E06C75" 
                    BorderThickness="1.5" 
                    CornerRadius="12" 
                    Padding="15,10">
                <StackPanel>
                    <TextBlock Text="CURRENT" 
                               FontSize="12" 
                               FontWeight="Bold" 
                               Foreground="#E06C75" 
                               Margin="5,0,0,2"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentText" 
                                   Text="0.000" 
                                   FontSize="44" 
                                   FontWeight="SemiBold"
                                   FontFamily="Consolas" 
                                   Foreground="White"/>
                        <TextBlock Text="A" 
                                   FontSize="32" 
                                   FontWeight="Bold"
                                   Foreground="#E06C75" 
                                   Margin="12,0,0,0" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" 
                Background="#111115" 
                BorderBrush="#3E4451" 
                BorderThickness="1.5" 
                CornerRadius="12" 
                Padding="15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,0,0,5">
                    <TextBlock Text="Current " FontSize="16" Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock Text="A" FontSize="16" Foreground="#4A90E2" FontWeight="Bold"/>
                </StackPanel>

                <scottplot:WinUIPlot x:Name="CurrentSignaturePlot" 
                                     Grid.Row="1" 
                                     Margin="0,5"
                                     HorizontalAlignment="Stretch" 
                                     VerticalAlignment="Stretch"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5,5,0,0" VerticalAlignment="Center">
                    <Ellipse Width="10" 
                             Height="10" 
                             Fill="#00FFC4" 
                             VerticalAlignment="Center" 
                             Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" 
                               Text="Connected @ 460800" 
                               FontSize="14" 
                               FontWeight="Medium"
                               Foreground="#00FFC4" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>