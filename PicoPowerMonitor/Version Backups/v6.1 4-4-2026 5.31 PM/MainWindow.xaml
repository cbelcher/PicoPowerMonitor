<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PicoPowerMonitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PicoPowerMonitor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Pico Power Monitor">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <StackPanel Spacing="10" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Port Selection Header -->
            <!-- <StackPanel Orientation="Horizontal" Spacing="10"> -->
                <!-- <ComboBox x:Name="PortSelector" Width="150" PlaceholderText="Select Port" /> -->
                <!-- <Button Content="Refresh" Click="RefreshPorts_Click"/> -->
                <!-- <Button Content="Connect" Click="ConnectButton_Click" Background="LightBlue"/> -->
            <!-- </StackPanel> -->

            <Rectangle Height="2" Fill="Gray" Margin="0,10"/>

            <TextBlock x:Name="VoltageText" Text="V: -- V" FontSize="32" FontWeight="Bold" FontFamily="Consolas" Foreground="Blue"/>
            <TextBlock x:Name="CurrentText" Text="I: -- A" FontSize="32" FontWeight="Bold" FontFamily="Consolas" Foreground="Red"/>
            <TextBlock x:Name="PowerText"   Text="P: -- W" FontSize="32" FontWeight="Bold" FontFamily="Consolas" Foreground="Gray"/>

            <TextBlock x:Name="StatusText" Text="Disconnected" Foreground="Red" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
